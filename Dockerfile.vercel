# Only this explicit runtime subset of the repository belongs in a public image.
FROM python:3.13-slim-bookworm AS source
WORKDIR /app
COPY requirements-chat.txt requirements-voice.txt launch_hologram.py vercel_host.py ./
COPY deploy/prepare_chat.py ./deploy/
COPY community/skills.json ./community/
COPY hologram/__init__.py hologram/chat.py hologram/catalog.py hologram/voice.py hologram/server.py hologram/skills.py hologram/zones.zip ./hologram/
COPY hologram/ui/index.html ./hologram/ui/
COPY hologram/licenses/ ./hologram/licenses/

FROM python:3.13-slim-bookworm AS native
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build && rm -rf /var/lib/apt/lists/*
ENV CMAKE_BUILD_PARALLEL_LEVEL=2 CMAKE_ARGS="-DGGML_NATIVE=OFF -DGGML_OPENMP=OFF -DGGML_LLAMAFILE=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=OFF -DLLAMA_CURL=OFF"
COPY --from=source /app/requirements-chat.txt /tmp/chat.txt
RUN python -m pip wheel --no-cache-dir --no-deps -r /tmp/chat.txt -w /wheels

FROM python:3.13-slim-bookworm AS assets
WORKDIR /app
COPY --from=source /app/ ./
RUN python vercel_host.py --seed-assets

FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2 PORT=8080 JARVIS_COMMUNITY_SYNC=1 JARVIS_CHAT_MODEL=/opt/amber-chat/gemma-3-1b-it-Q4_K_M.gguf
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgomp1 libstdc++6 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=source /app/ ./
COPY --from=native /wheels/ /wheels/
RUN python -m pip install --no-cache-dir --no-compile /wheels/*.whl -r requirements-voice.txt && rm -rf /wheels && python -c "from llama_cpp import Llama; from kokoro_onnx import Kokoro"
COPY --from=assets /opt/amber-chat /opt/amber-chat
COPY --from=assets /opt/amber-voice /opt/amber-voice
USER 10001:10001
EXPOSE 8080
CMD ["python", "vercel_host.py"]
